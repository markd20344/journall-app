//@version=6

// London Range Pullback Continuation (LRPC) Strategy
//
// Trades the pattern found by the breakout scanner: London's opening range
// breaks, price pulls back into London's range, then re-breaks in the
// original direction during the New York window.
//
// Setup: 1) London's opening range (default 08:00-09:00) closes outside
// its own high/low. 2) Price later trades back inside London's range (a
// pullback - requires one full bar fully clear of the range first, so the
// breakout candle's own wick can't count as the pullback). 3) Price closes
// back outside London's range in the ORIGINAL direction, during the NY
// entry window (default 13:30-17:00). That close is the entry trigger.
//
// Stop: beyond the deepest point reached during the pullback, plus a small
// buffer. Target: a measured move - London's own range height projected
// from the breakout level. Early exit: if price closes back inside
// London's range after entry (the continuation failed), close at market
// rather than waiting for the hard stop.
//
// All times are read in the timezone below. Position sizing is a
// simplified risk-based approximation (risk % of equity / stop distance in
// price) - it does not account for your broker's specific pip value, lot
// step or account currency, so treat position size as indicative only.

strategy("London Pullback Continuation Strategy", shorttitle="LRPC Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_every_tick=false)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

tzInput = input.string("Europe/London", title="Timezone", group="General")

londonStartH = input.int(8, title="Start Hour", minval=0, maxval=23, inline="ls", group="London Session")
londonStartM = input.int(0, title="Min", minval=0, maxval=59, inline="ls", group="London Session")
londonEndH   = input.int(9, title="End Hour", minval=0, maxval=23, inline="le", group="London Session")
londonEndM   = input.int(0, title="Min", minval=0, maxval=59, inline="le", group="London Session")

nyStartH = input.int(13, title="Start Hour", minval=0, maxval=23, inline="nys", group="NY Entry Window")
nyStartM = input.int(30, title="Min", minval=0, maxval=59, inline="nys", group="NY Entry Window")
nyEndH   = input.int(17, title="End Hour", minval=0, maxval=23, inline="nye", group="NY Entry Window")
nyEndM   = input.int(0, title="Min", minval=0, maxval=59, inline="nye", group="NY Entry Window")

stopBufferPips = input.float(2.0, title="Stop Buffer Beyond Pullback (pips)", minval=0, group="Risk")
riskPct = input.float(1.0, title="Risk per Trade (% of equity)", minval=0.1, group="Risk")

minRangeWidthPips = input.float(5.0, title="Minimum London Range Width (pips, 0 = off)", minval=0, group="Filters")
useAdxFilter = input.bool(true, title="Require ADX above threshold", group="Filters")
adxThreshold = input.float(20, title="ADX Threshold", group="Filters")
adxDiLength = input.int(14, title="ADX DI Length", minval=1, group="Filters")
adxSmoothing = input.int(14, title="ADX Smoothing", minval=1, group="Filters")

showStatusTable = input.bool(true, title="Show status table", group="Display")

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

pad2(n) =>
    n < 10 ? "0" + str.tostring(n) : str.tostring(n)

sessionString(sh, sm, eh, em) =>
    pad2(sh) + pad2(sm) + "-" + pad2(eh) + pad2(em)

pipSize = syminfo.mintick * (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001 ? 10 : 1)

// ---------------------------------------------------------------------------
// London range + break/pullback tracking
// ---------------------------------------------------------------------------

londonSess = sessionString(londonStartH, londonStartM, londonEndH, londonEndM)
t = time(timeframe.period, londonSess, tzInput)
inLondon = not na(t)

var float rangeHigh = na
var float rangeLow = na
var bool  dayHadRange = false
var bool  prevInLondon = false
var int   dayKey = na
var int   breakDirectionToday = 0
var bool  clearedRangeToday = false
var bool  pulledBackToday = false
var float pullbackExtreme = na
var bool  entryTakenToday = false
var float tradeRangeHigh = na
var float tradeRangeLow = na

curDayKey = year(time, tzInput) * 10000 + month(time, tzInput) * 100 + dayofmonth(time, tzInput)
isNewDay = na(dayKey) or curDayKey != dayKey
dayKey := curDayKey

if isNewDay
    rangeHigh := na
    rangeLow := na
    dayHadRange := false
    breakDirectionToday := 0
    clearedRangeToday := false
    pulledBackToday := false
    pullbackExtreme := na
    entryTakenToday := false

newLondon = inLondon and not prevInLondon
if newLondon
    rangeHigh := high
    rangeLow := low
    dayHadRange := true
else if inLondon
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)
prevInLondon := inLondon

if not inLondon and dayHadRange
    if breakDirectionToday == 0
        if close > rangeHigh
            breakDirectionToday := 1
        else if close < rangeLow
            breakDirectionToday := -1
    else if breakDirectionToday == 1
        if not clearedRangeToday
            if low > rangeHigh
                clearedRangeToday := true
        else if not pulledBackToday
            if low <= rangeHigh
                pulledBackToday := true
                pullbackExtreme := low
        else
            pullbackExtreme := math.min(pullbackExtreme, low)
    else
        if not clearedRangeToday
            if high < rangeLow
                clearedRangeToday := true
        else if not pulledBackToday
            if high >= rangeLow
                pulledBackToday := true
                pullbackExtreme := high
        else
            pullbackExtreme := math.max(pullbackExtreme, high)

// ---------------------------------------------------------------------------
// Entry window + filters
// ---------------------------------------------------------------------------

minutesNow = hour(time, tzInput) * 60 + minute(time, tzInput)
nyStartMinutes = nyStartH * 60 + nyStartM
nyEndMinutes = nyEndH * 60 + nyEndM
withinEntryWindow = minutesNow >= nyStartMinutes and minutesNow < nyEndMinutes

rangeWidthPips = dayHadRange ? (rangeHigh - rangeLow) / pipSize : na
rangeWidthOk = minRangeWidthPips <= 0 or (not na(rangeWidthPips) and rangeWidthPips >= minRangeWidthPips)

[adxDiPlus, adxDiMinus, adxValue] = ta.dmi(adxDiLength, adxSmoothing)
adxOk = not useAdxFilter or adxValue >= adxThreshold

longTrigger = withinEntryWindow and not entryTakenToday and breakDirectionToday == 1 and pulledBackToday and close > rangeHigh and rangeWidthOk and adxOk
shortTrigger = withinEntryWindow and not entryTakenToday and breakDirectionToday == -1 and pulledBackToday and close < rangeLow and rangeWidthOk and adxOk

rangeHeight = dayHadRange ? rangeHigh - rangeLow : na

// ---------------------------------------------------------------------------
// Entries
// ---------------------------------------------------------------------------

if longTrigger
    stopPrice = pullbackExtreme - stopBufferPips * pipSize
    targetPrice = rangeHigh + rangeHeight
    riskDistance = close - stopPrice
    if riskDistance > 0
        riskAmount = strategy.equity * (riskPct / 100)
        qty = riskAmount / riskDistance
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Exit Long", from_entry="Long", stop=stopPrice, limit=targetPrice)
        entryTakenToday := true
        tradeRangeHigh := rangeHigh
        tradeRangeLow := rangeLow

if shortTrigger
    stopPrice = pullbackExtreme + stopBufferPips * pipSize
    targetPrice = rangeLow - rangeHeight
    riskDistance = stopPrice - close
    if riskDistance > 0
        riskAmount = strategy.equity * (riskPct / 100)
        qty = riskAmount / riskDistance
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Exit Short", from_entry="Short", stop=stopPrice, limit=targetPrice)
        entryTakenToday := true
        tradeRangeHigh := rangeHigh
        tradeRangeLow := rangeLow

// ---------------------------------------------------------------------------
// Early exit: continuation failed (price closed back inside London's range)
// Uses the range captured AT ENTRY, not the live daily range, so this stays
// correct even if the trade is still open when a new day rolls over.
// ---------------------------------------------------------------------------

if strategy.position_size > 0 and not na(tradeRangeHigh) and close < tradeRangeHigh
    strategy.close("Long", comment="Failed continuation")

if strategy.position_size < 0 and not na(tradeRangeLow) and close > tradeRangeLow
    strategy.close("Short", comment="Failed continuation")

// ---------------------------------------------------------------------------
// Visuals
// ---------------------------------------------------------------------------

plot(dayHadRange ? rangeHigh : na, title="London High", color=color.new(color.blue, 40), style=plot.style_circles, linewidth=1)
plot(dayHadRange ? rangeLow : na, title="London Low", color=color.new(color.blue, 40), style=plot.style_circles, linewidth=1)

var table statusTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if showStatusTable and barstate.islast
    statusText = breakDirectionToday == 0 ? "Waiting for break" : not clearedRangeToday ? "Broke " + (breakDirectionToday == 1 ? "Up" : "Down") + ", awaiting clean separation" : not pulledBackToday ? "Clear of range, no pullback yet" : entryTakenToday ? "Trade taken today" : "Pulled back, awaiting re-break in window"
    table.cell(statusTable, 0, 0, "LRPC Status", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(statusTable, 1, 0, "", bgcolor=color.new(color.gray, 60))
    table.cell(statusTable, 0, 1, "Today", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 1, 1, statusText, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 0, 2, "In NY Window", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 1, 2, withinEntryWindow ? "Yes" : "No", text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 0, 3, "Range Width", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 1, 3, na(rangeWidthPips) ? "-" : str.tostring(rangeWidthPips, "#.#") + " pips", text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 0, 4, "ADX", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(statusTable, 1, 4, str.tostring(adxValue, "#.#") + (adxOk ? " OK" : " Below threshold"), text_color=adxOk ? color.green : color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
