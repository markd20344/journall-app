//@version=6

// Session Range Breakout Time Scanner
// Answers "what time does each session's opening range actually tend to
// break?" using the chart's own historical bars, instead of manually
// reviewing screenshots day by day. Scans Asian, London and New York
// opening ranges independently and shows their hourly first-break
// histograms side by side for comparison.
//
// For each enabled session, for each day in the lookback window, it
// records the hour (in the timezone below) of the FIRST bar whose close is
// outside that day's opening-range high/low. Asian additionally gets a
// "secondary window" check (default 07:00-07:30): how many days had a
// close outside the Asian range at some point during that window,
// regardless of whether it was the day's first break. Note this measures
// "still outside the range" rather than "a fresh event" - a day that broke
// hours earlier and simply kept drifting also counts.

indicator("Session Range Breakout Time Scanner", shorttitle="Range Scanner", overlay=false, max_labels_count=500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

tzInput = input.string("Europe/London", title="Timezone", group="General")
lookbackDays = input.int(90, title="Days to scan back", minval=5, maxval=730, group="General")

asianEnabled = input.bool(true, title="Enable", inline="asianEnable", group="Asian Session")
asianStartH  = input.int(1, title="Start Hour", minval=0, maxval=23, inline="asianStart", group="Asian Session")
asianStartM  = input.int(0, title="Start Min", minval=0, maxval=59, inline="asianStart", group="Asian Session")
asianEndH    = input.int(2, title="End Hour", minval=0, maxval=23, inline="asianEnd", group="Asian Session")
asianEndM    = input.int(0, title="End Min", minval=0, maxval=59, inline="asianEnd", group="Asian Session")

londonEnabled = input.bool(true, title="Enable", inline="londonEnable", group="London Session")
londonStartH  = input.int(8, title="Start Hour", minval=0, maxval=23, inline="londonStart", group="London Session")
londonStartM  = input.int(0, title="Start Min", minval=0, maxval=59, inline="londonStart", group="London Session")
londonEndH    = input.int(9, title="End Hour", minval=0, maxval=23, inline="londonEnd", group="London Session")
londonEndM    = input.int(0, title="End Min", minval=0, maxval=59, inline="londonEnd", group="London Session")

nyEnabled = input.bool(true, title="Enable", inline="nyEnable", group="New York Session")
nyStartH  = input.int(14, title="Start Hour", minval=0, maxval=23, inline="nyStart", group="New York Session")
nyStartM  = input.int(30, title="Start Min", minval=0, maxval=59, inline="nyStart", group="New York Session")
nyEndH    = input.int(15, title="End Hour", minval=0, maxval=23, inline="nyEnd", group="New York Session")
nyEndM    = input.int(30, title="End Min", minval=0, maxval=59, inline="nyEnd", group="New York Session")

trackAsianSecondaryWindow = input.bool(true, title="Track secondary window (Asian only)", group="Secondary Window")
winStartH = input.int(7, title="Start Hour", minval=0, maxval=23, inline="winStart", group="Secondary Window")
winStartM = input.int(0, title="Start Min", minval=0, maxval=59, inline="winStart", group="Secondary Window")
winEndH   = input.int(7, title="End Hour", minval=0, maxval=23, inline="winEnd", group="Secondary Window")
winEndM   = input.int(30, title="End Min", minval=0, maxval=59, inline="winEnd", group="Secondary Window")

pullbackTrackEnabled = input.bool(true, title="Track London pullback -> New York continuation", group="London Pullback (NY)")
pullbackCutoffH = input.int(22, title="Cutoff Hour", minval=0, maxval=23, inline="pbCutoff", group="London Pullback (NY)", tooltip="A pullback that hasn't resolved into a continuation by this time (in the timezone above) counts as failed rather than pending.")
pullbackCutoffM = input.int(0, title="Cutoff Min", minval=0, maxval=59, inline="pbCutoff", group="London Pullback (NY)")

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

pad2(n) =>
    n < 10 ? "0" + str.tostring(n) : str.tostring(n)

sessionString(startH, startM, endH, endM) =>
    pad2(startH) + pad2(startM) + "-" + pad2(endH) + pad2(endM)

// 5-decimal and 3-decimal feeds are "fractional pip" quotes (pip = 10
// ticks); 4-decimal and 2-decimal (JPY) feeds already quote in whole pips.
pipSize = syminfo.mintick * (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001 ? 10 : 1)

// idx encoding used throughout: 0 = Up, 1 = Down, 2 = Flat (never broke)
dirLabel(int idx) =>
    idx == 0 ? "Up" : idx == 1 ? "Down" : "Flat"

outcomeLabel(int idx) =>
    idx == 0 ? "Direct" : idx == 1 ? "Pullback->Continue" : "Pullback->Failed"

// ---------------------------------------------------------------------------
// Per-session scan state
// ---------------------------------------------------------------------------

type ScanState
    float rangeHigh = na
    float rangeLow = na
    bool  dayHadRange = false
    bool  firstBreakDoneToday = false
    bool  secondaryWindowHitToday = false
    bool  prevInSess = false
    int   breakDirectionToday = 0
    int   finalizedDir = 0
    bool  finalizedValid = false
    int   totalDaysScanned = 0
    int   secondaryWindowDays = 0
    array<int>   hourCounts
    array<float> dayRangeHist

avgRangePips(ScanState state) =>
    state.dayRangeHist.size() == 0 ? na : array.sum(state.dayRangeHist) / state.dayRangeHist.size() / pipSize

// Tracks one session's opening range across the whole chart history and
// accumulates its hourly first-break histogram (plus, optionally, the
// secondary-window tally). `isNewDay`/`withinLookback` are computed once,
// shared across all three sessions since the calendar day is the same
// for all of them.
scanSession(ScanState state, bool enabled, string sess, string tz, bool isNewDay, bool withinLookback, bool checkSecondaryWindow, int winStartMinutes, int winEndMinutes) =>
    if enabled
        t = time(timeframe.period, sess, tz)
        inSess = not na(t)
        newSess = inSess and not state.prevInSess

        if isNewDay
            if state.dayHadRange and withinLookback
                state.totalDaysScanned += 1
                if checkSecondaryWindow and state.secondaryWindowHitToday
                    state.secondaryWindowDays += 1
                state.dayRangeHist.push(state.rangeHigh - state.rangeLow)
                state.finalizedDir := state.breakDirectionToday
                state.finalizedValid := true
            else
                state.finalizedValid := false
            state.rangeHigh := na
            state.rangeLow := na
            state.firstBreakDoneToday := false
            state.secondaryWindowHitToday := false
            state.dayHadRange := false
            state.breakDirectionToday := 0

        if newSess
            state.rangeHigh := high
            state.rangeLow := low
            state.dayHadRange := true
        else if inSess
            state.rangeHigh := math.max(state.rangeHigh, high)
            state.rangeLow := math.min(state.rangeLow, low)

        if not inSess and state.dayHadRange
            isBreakoutBar = close > state.rangeHigh or close < state.rangeLow
            if isBreakoutBar
                curHour = hour(time, tz)
                if not state.firstBreakDoneToday
                    state.firstBreakDoneToday := true
                    state.breakDirectionToday := close > state.rangeHigh ? 1 : -1
                    if withinLookback
                        state.hourCounts.set(curHour, state.hourCounts.get(curHour) + 1)
                if checkSecondaryWindow and not state.secondaryWindowHitToday
                    curMin = minute(time, tz)
                    minutesNow = curHour * 60 + curMin
                    if minutesNow >= winStartMinutes and minutesNow < winEndMinutes
                        state.secondaryWindowHitToday := true

        state.prevInSess := inSess
    true

// ---------------------------------------------------------------------------
// London pullback -> New York continuation tracker
//
// For days London broke its own range, checks whether price later traded
// back into London's range (a "pullback") before the trading-day cutoff,
// and if so, whether it went on to re-break London's range in the same
// original direction ("continued") or never did ("failed"). Days with no
// pullback at all are "direct" continuations.
// ---------------------------------------------------------------------------

type PullbackState
    bool pulledBackToday = false
    bool continuedAfterPullback = false
    array<int> outcomeCounts

// outcomeCounts index = dirIdx * 3 + outcomeIdx
// dirIdx: 0 = London broke Up, 1 = London broke Down
// outcomeIdx: 0 = Direct (no pullback), 1 = Pullback then continued, 2 = Pullback then failed
trackPullback(PullbackState pb, ScanState sess, bool enabled, bool isNewDay, bool withinLookback, bool withinWindow) =>
    if enabled
        if isNewDay
            if sess.finalizedValid and sess.finalizedDir != 0 and withinLookback
                dirIdx = sess.finalizedDir == 1 ? 0 : 1
                outcomeIdx = not pb.pulledBackToday ? 0 : pb.continuedAfterPullback ? 1 : 2
                idx = dirIdx * 3 + outcomeIdx
                pb.outcomeCounts.set(idx, pb.outcomeCounts.get(idx) + 1)
            pb.pulledBackToday := false
            pb.continuedAfterPullback := false
        else if withinWindow and sess.breakDirectionToday != 0 and not na(sess.rangeHigh)
            if sess.breakDirectionToday == 1
                if not pb.pulledBackToday and low <= sess.rangeHigh
                    pb.pulledBackToday := true
                if pb.pulledBackToday and not pb.continuedAfterPullback and close > sess.rangeHigh
                    pb.continuedAfterPullback := true
            else
                if not pb.pulledBackToday and high >= sess.rangeLow
                    pb.pulledBackToday := true
                if pb.pulledBackToday and not pb.continuedAfterPullback and close < sess.rangeLow
                    pb.continuedAfterPullback := true
    true

// ---------------------------------------------------------------------------
// Run all three sessions
// ---------------------------------------------------------------------------

var ScanState asianScan  = ScanState.new(hourCounts=array.new<int>(24, 0), dayRangeHist=array.new<float>())
var ScanState londonScan = ScanState.new(hourCounts=array.new<int>(24, 0), dayRangeHist=array.new<float>())
var ScanState nyScan     = ScanState.new(hourCounts=array.new<int>(24, 0), dayRangeHist=array.new<float>())
var PullbackState londonPullback = PullbackState.new(outcomeCounts=array.new<int>(6, 0))

var int dayKey = na
curDayKey = year(time, tzInput) * 10000 + month(time, tzInput) * 100 + dayofmonth(time, tzInput)
isNewDay = na(dayKey) or curDayKey != dayKey
dayKey := curDayKey

withinLookback = time >= (last_bar_time - lookbackDays * 24 * 60 * 60 * 1000)

winStartMinutes = winStartH * 60 + winStartM
winEndMinutes = winEndH * 60 + winEndM

pbCutoffMinutes = pullbackCutoffH * 60 + pullbackCutoffM
curMinutesOfDay = hour(time, tzInput) * 60 + minute(time, tzInput)
withinPullbackWindow = curMinutesOfDay < pbCutoffMinutes

scanSession(asianScan, asianEnabled, sessionString(asianStartH, asianStartM, asianEndH, asianEndM), tzInput, isNewDay, withinLookback, trackAsianSecondaryWindow, winStartMinutes, winEndMinutes)
scanSession(londonScan, londonEnabled, sessionString(londonStartH, londonStartM, londonEndH, londonEndM), tzInput, isNewDay, withinLookback, false, winStartMinutes, winEndMinutes)
scanSession(nyScan, nyEnabled, sessionString(nyStartH, nyStartM, nyEndH, nyEndM), tzInput, isNewDay, withinLookback, false, winStartMinutes, winEndMinutes)

trackPullback(londonPullback, londonScan, pullbackTrackEnabled and londonEnabled, isNewDay, withinLookback, withinPullbackWindow)

// ---------------------------------------------------------------------------
// Asian -> London -> New York transition tally
//
// Each session's day outcome is Up (broke and closed above its range),
// Down (broke and closed below), or Flat (never closed outside its own
// range that day). A day only counts here if all three sessions are
// enabled and completed a valid range on it - only "London continued/
// reversed Asian" is derived by comparing directions; New York's outcome
// is tallied against the full (Asian, London) pair, not London alone, so
// the table reads as a genuine 3-level chain.
// ---------------------------------------------------------------------------

var array<int> pathCounts = array.new<int>(27, 0)
var int pathDaysTotal = 0

if isNewDay and asianScan.finalizedValid and londonScan.finalizedValid and nyScan.finalizedValid
    asianIdx = asianScan.finalizedDir == 1 ? 0 : asianScan.finalizedDir == -1 ? 1 : 2
    londonIdx = londonScan.finalizedDir == 1 ? 0 : londonScan.finalizedDir == -1 ? 1 : 2
    nyIdx = nyScan.finalizedDir == 1 ? 0 : nyScan.finalizedDir == -1 ? 1 : 2
    pathIdx = asianIdx * 9 + londonIdx * 3 + nyIdx
    pathCounts.set(pathIdx, pathCounts.get(pathIdx) + 1)
    pathDaysTotal += 1

// How many days had a given session (0=Asian, 1=London, 2=NY) sit at a
// given direction (0=Up, 1=Down, 2=Flat), regardless of the other two -
// each session's own unconditional (marginal) rate, derived by summing the
// matching slice of the joint table rather than tracking it separately.
marginalCount(int sessionPos, int wantIdx) =>
    total = 0
    for a = 0 to 2
        for l = 0 to 2
            for n = 0 to 2
                idx = a * 9 + l * 3 + n
                matches = sessionPos == 0 ? a == wantIdx : sessionPos == 1 ? l == wantIdx : n == wantIdx
                if matches
                    total += pathCounts.get(idx)
    total

// ---------------------------------------------------------------------------
// Results table: Hour | Asian | London | New York
// ---------------------------------------------------------------------------

var table resultsTable = table.new(position.top_right, 4, 28, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if barstate.islast
    table.cell(resultsTable, 0, 0, "Hour (" + tzInput + ")", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 1, 0, "Asian", text_color=color.yellow, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 2, 0, "London", text_color=color.blue, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 3, 0, "New York", text_color=color.red, bgcolor=color.new(color.gray, 60), text_size=size.small)

    for h = 0 to 23
        asianCnt = asianScan.hourCounts.get(h)
        londonCnt = londonScan.hourCounts.get(h)
        nyCnt = nyScan.hourCounts.get(h)
        table.cell(resultsTable, 0, h + 1, pad2(h) + ":00", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.tiny)
        table.cell(resultsTable, 1, h + 1, str.tostring(asianCnt), text_color=color.white, bgcolor=asianCnt > 0 ? color.new(color.teal, 70) : color.new(color.black, 15), text_size=size.tiny)
        table.cell(resultsTable, 2, h + 1, str.tostring(londonCnt), text_color=color.white, bgcolor=londonCnt > 0 ? color.new(color.teal, 70) : color.new(color.black, 15), text_size=size.tiny)
        table.cell(resultsTable, 3, h + 1, str.tostring(nyCnt), text_color=color.white, bgcolor=nyCnt > 0 ? color.new(color.teal, 70) : color.new(color.black, 15), text_size=size.tiny)

    table.cell(resultsTable, 0, 25, "Days scanned", text_color=color.gray, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 1, 25, str.tostring(asianScan.totalDaysScanned), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 2, 25, str.tostring(londonScan.totalDaysScanned), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 3, 25, str.tostring(nyScan.totalDaysScanned), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

    winLabel = pad2(winStartH) + ":" + pad2(winStartM) + "-" + pad2(winEndH) + ":" + pad2(winEndM)
    asianSecondaryPct = asianScan.totalDaysScanned == 0 ? 0.0 : (asianScan.secondaryWindowDays / asianScan.totalDaysScanned) * 100
    secondaryText = trackAsianSecondaryWindow ? str.tostring(asianScan.secondaryWindowDays) + " (" + str.tostring(asianSecondaryPct, "#.#") + "%)" : "off"
    table.cell(resultsTable, 0, 26, winLabel + " hit", text_color=color.gray, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 1, 26, secondaryText, text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 2, 26, "-", text_color=color.gray, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 3, 26, "-", text_color=color.gray, bgcolor=color.new(color.gray, 60), text_size=size.small)

    asianAvgRange = avgRangePips(asianScan)
    londonAvgRange = avgRangePips(londonScan)
    nyAvgRange = avgRangePips(nyScan)
    table.cell(resultsTable, 0, 27, "Avg Range (pips)", text_color=color.gray, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 1, 27, na(asianAvgRange) ? "-" : str.tostring(asianAvgRange, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 2, 27, na(londonAvgRange) ? "-" : str.tostring(londonAvgRange, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(resultsTable, 3, 27, na(nyAvgRange) ? "-" : str.tostring(nyAvgRange, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

// ---------------------------------------------------------------------------
// Session transition matrix: Asian -> London -> New York
//
// "London" and "New York" here are each session's OWN range breakout
// direction, not a derived continuation/reversal label - read a row by
// comparing the three directions yourself, e.g. Up/Up/Up is a full
// continuation day, Up/Down/Up is a London fade that New York reversed
// back through. Only days where all three sessions completed a valid
// range are counted (see pathDaysTotal), so this total can be lower than
// each session's own "Days scanned" above.
// ---------------------------------------------------------------------------

var table pathTable = table.new(position.top_left, 6, 29, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if barstate.islast
    // Row 0 stays blank so this table's header clears the pane's own
    // top-left script-name legend instead of sitting under it.
    table.cell(pathTable, 0, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(pathTable, 1, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(pathTable, 2, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(pathTable, 3, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(pathTable, 4, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(pathTable, 5, 0, "", bgcolor=color.new(color.black, 100))

    table.cell(pathTable, 0, 1, "Asian", text_color=color.yellow, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pathTable, 1, 1, "London", text_color=color.blue, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pathTable, 2, 1, "New York", text_color=color.red, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pathTable, 3, 1, "Days", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pathTable, 4, 1, "%", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pathTable, 5, 1, "Expected %", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

    for asianIdx = 0 to 2
        for londonIdx = 0 to 2
            for nyIdx = 0 to 2
                pathIdx = asianIdx * 9 + londonIdx * 3 + nyIdx
                cnt = pathCounts.get(pathIdx)
                pct = pathDaysTotal == 0 ? 0.0 : (cnt / pathDaysTotal) * 100
                asianMarginal = pathDaysTotal == 0 ? 0.0 : marginalCount(0, asianIdx) / pathDaysTotal
                londonMarginal = pathDaysTotal == 0 ? 0.0 : marginalCount(1, londonIdx) / pathDaysTotal
                nyMarginal = pathDaysTotal == 0 ? 0.0 : marginalCount(2, nyIdx) / pathDaysTotal
                expectedPct = asianMarginal * londonMarginal * nyMarginal * 100
                rowNum = pathIdx + 2
                isFullChain = asianIdx == londonIdx and londonIdx == nyIdx and asianIdx != 2
                rowBg = cnt == 0 ? color.new(color.black, 15) : isFullChain ? color.new(color.lime, 65) : color.new(color.teal, 80)
                table.cell(pathTable, 0, rowNum, dirLabel(asianIdx), text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)
                table.cell(pathTable, 1, rowNum, dirLabel(londonIdx), text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)
                table.cell(pathTable, 2, rowNum, dirLabel(nyIdx), text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)
                table.cell(pathTable, 3, rowNum, str.tostring(cnt), text_color=color.white, bgcolor=rowBg, text_size=size.tiny)
                table.cell(pathTable, 4, rowNum, str.tostring(pct, "#.#") + "%", text_color=color.white, bgcolor=rowBg, text_size=size.tiny)
                table.cell(pathTable, 5, rowNum, str.tostring(expectedPct, "#.#") + "%", text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)

// ---------------------------------------------------------------------------
// London pullback -> New York continuation results
//
// For days London broke Up or Down: "Direct" = New York never dipped back
// into London's range at all, "Pullback -> Continue" = it dipped back into
// London's range and later re-broke it in the same original direction
// (the "UK trend, NY pulls back then follows" pattern), "Pullback ->
// Failed" = it dipped back in and never re-broke that direction before the
// cutoff.
// ---------------------------------------------------------------------------

var table pullbackTable = table.new(position.top_center, 4, 7, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if barstate.islast and pullbackTrackEnabled
    table.cell(pullbackTable, 0, 0, "London", text_color=color.blue, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pullbackTable, 1, 0, "NY Outcome", text_color=color.red, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pullbackTable, 2, 0, "Days", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(pullbackTable, 3, 0, "%", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

    for dirIdx = 0 to 1
        dirTotal = londonPullback.outcomeCounts.get(dirIdx * 3) + londonPullback.outcomeCounts.get(dirIdx * 3 + 1) + londonPullback.outcomeCounts.get(dirIdx * 3 + 2)
        for outcomeIdx = 0 to 2
            idx = dirIdx * 3 + outcomeIdx
            cnt = londonPullback.outcomeCounts.get(idx)
            pct = dirTotal == 0 ? 0.0 : (cnt / dirTotal) * 100
            rowNum = idx + 1
            rowBg = cnt == 0 ? color.new(color.black, 15) : outcomeIdx == 1 ? color.new(color.lime, 65) : color.new(color.teal, 80)
            table.cell(pullbackTable, 0, rowNum, dirIdx == 0 ? "Up" : "Down", text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)
            table.cell(pullbackTable, 1, rowNum, outcomeLabel(outcomeIdx), text_color=color.gray, bgcolor=rowBg, text_size=size.tiny)
            table.cell(pullbackTable, 2, rowNum, str.tostring(cnt), text_color=color.white, bgcolor=rowBg, text_size=size.tiny)
            table.cell(pullbackTable, 3, rowNum, str.tostring(pct, "#.#") + "%", text_color=color.white, bgcolor=rowBg, text_size=size.tiny)
