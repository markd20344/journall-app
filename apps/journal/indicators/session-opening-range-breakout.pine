//@version=6

// Session Opening Range Breakout (ORB) + EMA
// Marks the opening-range high/low of the Asian, London and New York sessions
// and rays them across the rest of the day so you can compare how each
// session's range broke out (or didn't) relative to the others.
//
// Usage notes:
//  - Use an intraday chart at or below the shortest session's range length
//    (e.g. 1m-5m) so the opening-range high/low builds up accurately tick by
//    tick rather than in coarse steps.
//  - All session start/end times are read in the timezone set below, so
//    "Europe/London" will automatically follow GMT/BST without you having to
//    change anything across the clock change.
//  - Alerts fire once per range, the first time price closes back outside
//    the range after that session's opening hour has finished forming.

indicator("Session Opening Range Breakout + EMA", shorttitle="ORB+EMA", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

tzInput = input.string("Europe/London", title="Session Timezone (IANA name)", group="General", tooltip="Examples: Europe/London, America/New_York, UTC. Europe/London auto-adjusts for GMT/BST.")
maxDaysHistory = input.int(30, title="Keep last N days of ranges", minval=1, maxval=100, group="General")
showBoxInput = input.bool(true, title="Highlight opening-range hour with a box", group="General")
showBoxBorderInput = input.bool(false, title="Show box border (vertical/horizontal edges)", group="General")
showLabelsInput = input.bool(true, title="Show session name labels", group="General")
showBreakoutMarkersInput = input.bool(true, title="Show breakout markers", group="General")
lineWidthInput = input.int(1, title="Range ray line width", minval=1, maxval=4, group="General")
cutoffHourInput = input.int(22, title="Cut off rays at (Hour)", minval=0, maxval=23, inline="cutoff", group="General", tooltip="Rays stop extending at this time (in the session timezone above) instead of running to midnight.")
cutoffMinuteInput = input.int(0, title="Min", minval=0, maxval=59, inline="cutoff", group="General")
showTableInput = input.bool(true, title="Show pip range table", group="General")
tableTopOffsetInput = input.int(1, title="Push pip table down (blank rows, avoids TradingView icons)", minval=0, maxval=10, group="General")
showDaysTableInput = input.bool(true, title="Show daily red/green day table", group="General")
daysToShowInput = input.int(28, title="Days to show in red/green table", minval=5, maxval=40, group="General")

asianEnabled = input.bool(true, title="Enable", inline="asianEnable", group="Asian Session")
asianColor   = input.color(color.yellow, title="Color", inline="asianEnable", group="Asian Session")
asianStartH  = input.int(1, title="Start Hour", minval=0, maxval=23, inline="asianStart", group="Asian Session")
asianStartM  = input.int(0, title="Start Min", minval=0, maxval=59, inline="asianStart", group="Asian Session")
asianEndH    = input.int(2, title="End Hour", minval=0, maxval=23, inline="asianEnd", group="Asian Session")
asianEndM    = input.int(0, title="End Min", minval=0, maxval=59, inline="asianEnd", group="Asian Session")

londonEnabled = input.bool(true, title="Enable", inline="londonEnable", group="London Session")
londonColor   = input.color(color.blue, title="Color", inline="londonEnable", group="London Session")
londonStartH  = input.int(8, title="Start Hour", minval=0, maxval=23, inline="londonStart", group="London Session")
londonStartM  = input.int(0, title="Start Min", minval=0, maxval=59, inline="londonStart", group="London Session")
londonEndH    = input.int(9, title="End Hour", minval=0, maxval=23, inline="londonEnd", group="London Session")
londonEndM    = input.int(0, title="End Min", minval=0, maxval=59, inline="londonEnd", group="London Session")

nyEnabled = input.bool(true, title="Enable", inline="nyEnable", group="New York Session")
nyColor   = input.color(color.red, title="Color", inline="nyEnable", group="New York Session")
nyStartH  = input.int(14, title="Start Hour", minval=0, maxval=23, inline="nyStart", group="New York Session")
nyStartM  = input.int(30, title="Start Min", minval=0, maxval=59, inline="nyStart", group="New York Session")
nyEndH    = input.int(15, title="End Hour", minval=0, maxval=23, inline="nyEnd", group="New York Session")
nyEndM    = input.int(30, title="End Min", minval=0, maxval=59, inline="nyEnd", group="New York Session")

emaEnabled = input.bool(true, title="Show EMA", group="EMA")
emaSource  = input.source(close, title="Source", group="EMA")
emaLength  = input.int(8, title="Length", minval=1, group="EMA")
emaColor   = input.color(color.red, title="Color", group="EMA")
emaWidth   = input.int(2, title="Line Width", minval=1, maxval=4, group="EMA")

adrEnabled = input.bool(true, title="Show ADR (in pip table)", group="ADR")
adrLength = input.int(10, title="ADR Lookback (completed days)", minval=1, maxval=50, group="ADR")
adrShowLines = input.bool(true, title="Show projected high/low lines from today's open", group="ADR")
adrLineColor = input.color(color.purple, title="ADR Line Color", group="ADR")

tdiEnabled = input.bool(true, title="Show TDI reading (in pip table)", group="TDI")
tdiRsiLength = input.int(13, title="RSI Period", minval=1, group="TDI")
tdiPriceLineLength = input.int(2, title="Price Line Smoothing", minval=1, group="TDI")

adxEnabled = input.bool(true, title="Show ADX reading (in pip table)", group="ADX")
adxDiLength = input.int(14, title="DI Length", minval=1, group="ADX")
adxSmoothing = input.int(14, title="ADX Smoothing", minval=1, group="ADX")

openLineEnabled = input.bool(true, title="Show today's open as a ray", group="Open Line")
openLineColor = input.color(color.yellow, title="Color", group="Open Line")
openLineWidth = input.int(2, title="Width", minval=1, maxval=4, group="Open Line")

pivotsEnabled = input.bool(true, title="Show Mauro Pivot Levels (PP/R1/R2/S1/S2)", group="Mauro Pivots")
pivotShowMidpoints = input.bool(true, title="Show Midpoint Levels (M1-M4)", group="Mauro Pivots")
pivotShowLabels = input.bool(true, title="Show Level Labels", group="Mauro Pivots")
pivotLineWidth = input.int(1, title="Major Level Line Width", minval=1, maxval=4, group="Mauro Pivots")
ppColor = input.color(color.white, title="PP Color", group="Mauro Pivots")
resistanceColor = input.color(#ff5252, title="Resistance (R1/R2) Color", group="Mauro Pivots")
supportColor = input.color(#4fc3f7, title="Support (S1/S2) Color", group="Mauro Pivots")
midColor = input.color(color.gray, title="Midpoint (M1-M4) Color", group="Mauro Pivots")
pivotExtendBars = input.int(15, title="Extend lines past price for label room (bars)", minval=0, maxval=100, group="Mauro Pivots")

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

type SessionState
    line  topLine
    line  botLine
    box   rangeBox
    label rangeLabel
    float rangeHigh = na
    float rangeLow = na
    int   startIdx = na
    int   rangeDay = na
    bool  breakUpFired = false
    bool  breakDownFired = false
    bool  currentlyInSession = false
    array<line>  topHist
    array<line>  botHist
    array<box>   boxHist
    array<label> labelHist

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

pad2(n) =>
    n < 10 ? "0" + str.tostring(n) : str.tostring(n)

sessionString(startH, startM, endH, endM) =>
    pad2(startH) + pad2(startM) + "-" + pad2(endH) + pad2(endM)

// First letter of the day name (Tue/Thu and Sat/Sun share a letter, same as
// most single-letter weekday strips).
dayLetter(int dow) =>
    string result = "S"
    if dow == dayofweek.monday
        result := "M"
    else if dow == dayofweek.tuesday
        result := "T"
    else if dow == dayofweek.wednesday
        result := "W"
    else if dow == dayofweek.thursday
        result := "T"
    else if dow == dayofweek.friday
        result := "F"
    result

// 5-decimal (0.00001) and 3-decimal (0.001) feeds are "fractional pip" quotes,
// so a real pip there is 10 ticks; 4-decimal and 2-decimal (JPY) feeds already
// quote in whole pips.
pipSize = syminfo.mintick * (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001 ? 10 : 1)

// Short status for the table: "Pending" before the range starts today,
// "Forming" while the first hour is still building, then the width in pips.
sessionStatusText(SessionState state, bool enabled, int todayKey) =>
    string txt = "Off"
    if enabled
        if state.currentlyInSession
            txt := "Forming"
        else if state.rangeDay == todayKey and not na(state.rangeHigh)
            pips = (state.rangeHigh - state.rangeLow) / pipSize
            txt := str.tostring(pips, "#.#") + " pips"
        else
            txt := "Pending"
    txt

// Repositions a single persistent pivot-level line (and its optional label)
// to today's value each day, extending it to bar_index + extendBars while
// `extend` is true and freezing it once the trading-day cutoff is passed.
// The extra bars beyond the current price give the label clear space to sit
// in instead of getting clipped against the last candle. `dashed` picks
// solid (major levels) vs dashed (midpoint levels) style. Lines are drawn
// with extra transparency to stay subtle rather than bold; the label is
// opaque and normal-sized so it stays legible despite the subtle line.
pivotLevel(line ln, label lbl, float price, string levelName, color col, int widthPx, int startIdx, int curIdx, int extendBars, bool extend, bool showLabel, bool dashed) =>
    line resultLine = ln
    label resultLabel = lbl
    lineColor = color.new(col, 45)
    lineEndIdx = curIdx + extendBars
    if not na(price)
        if na(resultLine)
            resultLine := line.new(x1=startIdx, y1=price, x2=startIdx, y2=price, color=lineColor, width=widthPx, style=dashed ? line.style_dashed : line.style_solid)
        if extend
            line.set_xy1(resultLine, startIdx, price)
            line.set_xy2(resultLine, lineEndIdx, price)
        if showLabel
            if na(resultLabel)
                resultLabel := label.new(x=lineEndIdx, y=price, text=levelName, style=label.style_label_right, color=color.new(color.black, 10), textcolor=col, size=size.small)
            if extend
                label.set_xy(resultLabel, lineEndIdx, price)
        else if not na(resultLabel)
            label.delete(resultLabel)
            resultLabel := na
    [resultLine, resultLabel]

trimLines(array<line> arr, int maxDays) =>
    if arr.size() > maxDays
        line.delete(arr.shift())

trimBoxes(array<box> arr, int maxDays) =>
    if arr.size() > maxDays
        box.delete(arr.shift())

trimLabels(array<label> arr, int maxDays) =>
    if arr.size() > maxDays
        label.delete(arr.shift())

// Builds/updates one session's opening-range lines, box and label, and
// returns [breakoutUp, breakoutDown] flags that fire once per finished range.
processSession(SessionState state, bool enabled, string sess, string tz, color col, bool showBox, bool showBoxBorder, bool showLabel, string labelText, int maxDays, int widthPx, int cutoffHour, int cutoffMinute) =>
    var bool prevInSession = false
    bool breakUp = false
    bool breakDown = false

    if enabled
        t = time(timeframe.period, sess, tz)
        inSess = not na(t)
        newSess = inSess and not prevInSession
        currentDay = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
        sameDay = currentDay == state.rangeDay
        curMinutesOfDay = hour(time, tz) * 60 + minute(time, tz)
        cutoffMinutesOfDay = cutoffHour * 60 + cutoffMinute
        withinTradingDay = sameDay and curMinutesOfDay < cutoffMinutesOfDay

        if newSess
            state.rangeHigh := high
            state.rangeLow := low
            state.startIdx := bar_index
            state.rangeDay := currentDay
            state.breakUpFired := false
            state.breakDownFired := false

            newTop = line.new(x1=bar_index, y1=high, x2=bar_index, y2=high, xloc=xloc.bar_index, extend=extend.none, color=col, width=widthPx)
            newBot = line.new(x1=bar_index, y1=low, x2=bar_index, y2=low, xloc=xloc.bar_index, extend=extend.none, color=col, width=widthPx)
            state.topLine := newTop
            state.botLine := newBot
            state.topHist.push(newTop)
            state.botHist.push(newBot)
            trimLines(state.topHist, maxDays)
            trimLines(state.botHist, maxDays)

            if showBox
                newBox = box.new(left=bar_index, top=high, right=bar_index, bottom=low, border_color=showBoxBorder ? col : color.new(col, 100), border_width=1, bgcolor=color.new(col, 85))
                state.rangeBox := newBox
                state.boxHist.push(newBox)
                trimBoxes(state.boxHist, maxDays)
            if showLabel
                newLbl = label.new(x=bar_index, y=high, text=labelText, style=label.style_label_down, color=color.new(color.black, 15), textcolor=col, size=size.small)
                state.rangeLabel := newLbl
                state.labelHist.push(newLbl)
                trimLabels(state.labelHist, maxDays)
        else if inSess
            state.rangeHigh := math.max(state.rangeHigh, high)
            state.rangeLow := math.min(state.rangeLow, low)

        if inSess and not na(state.topLine)
            line.set_xy1(state.topLine, state.startIdx, state.rangeHigh)
            line.set_xy2(state.topLine, bar_index, state.rangeHigh)
            line.set_xy1(state.botLine, state.startIdx, state.rangeLow)
            line.set_xy2(state.botLine, bar_index, state.rangeLow)
            if not na(state.rangeBox)
                box.set_top(state.rangeBox, state.rangeHigh)
                box.set_bottom(state.rangeBox, state.rangeLow)
                box.set_right(state.rangeBox, bar_index)
            if not na(state.rangeLabel)
                label.set_xy(state.rangeLabel, state.startIdx, state.rangeHigh)
        else if not inSess and not na(state.topLine) and withinTradingDay
            line.set_xy2(state.topLine, bar_index, state.rangeHigh)
            line.set_xy2(state.botLine, bar_index, state.rangeLow)

        if not inSess and not na(state.rangeHigh) and withinTradingDay
            if not state.breakUpFired and close > state.rangeHigh
                breakUp := true
                state.breakUpFired := true
            if not state.breakDownFired and close < state.rangeLow
                breakDown := true
                state.breakDownFired := true

        prevInSession := inSess
        state.currentlyInSession := inSess

    [breakUp, breakDown]

// ---------------------------------------------------------------------------
// State (one persistent object per session)
// ---------------------------------------------------------------------------

var SessionState asianState  = SessionState.new(topHist=array.new<line>(), botHist=array.new<line>(), boxHist=array.new<box>(), labelHist=array.new<label>())
var SessionState londonState = SessionState.new(topHist=array.new<line>(), botHist=array.new<line>(), boxHist=array.new<box>(), labelHist=array.new<label>())
var SessionState nyState     = SessionState.new(topHist=array.new<line>(), botHist=array.new<line>(), boxHist=array.new<box>(), labelHist=array.new<label>())

// ---------------------------------------------------------------------------
// Run each session
// ---------------------------------------------------------------------------

[asianBreakUp, asianBreakDown] = processSession(asianState, asianEnabled, sessionString(asianStartH, asianStartM, asianEndH, asianEndM), tzInput, asianColor, showBoxInput, showBoxBorderInput, showLabelsInput, "ASIA", maxDaysHistory, lineWidthInput, cutoffHourInput, cutoffMinuteInput)
[londonBreakUp, londonBreakDown] = processSession(londonState, londonEnabled, sessionString(londonStartH, londonStartM, londonEndH, londonEndM), tzInput, londonColor, showBoxInput, showBoxBorderInput, showLabelsInput, "LONDON", maxDaysHistory, lineWidthInput, cutoffHourInput, cutoffMinuteInput)
[nyBreakUp, nyBreakDown] = processSession(nyState, nyEnabled, sessionString(nyStartH, nyStartM, nyEndH, nyEndM), tzInput, nyColor, showBoxInput, showBoxBorderInput, showLabelsInput, "NEW YORK", maxDaysHistory, lineWidthInput, cutoffHourInput, cutoffMinuteInput)

// ---------------------------------------------------------------------------
// Breakout markers
// ---------------------------------------------------------------------------

plotshape(showBreakoutMarkersInput and asianBreakUp, title="Asian Break Up", style=shape.triangleup, location=location.abovebar, color=asianColor, size=size.tiny)
plotshape(showBreakoutMarkersInput and asianBreakDown, title="Asian Break Down", style=shape.triangledown, location=location.belowbar, color=asianColor, size=size.tiny)
plotshape(showBreakoutMarkersInput and londonBreakUp, title="London Break Up", style=shape.triangleup, location=location.abovebar, color=londonColor, size=size.tiny)
plotshape(showBreakoutMarkersInput and londonBreakDown, title="London Break Down", style=shape.triangledown, location=location.belowbar, color=londonColor, size=size.tiny)
plotshape(showBreakoutMarkersInput and nyBreakUp, title="New York Break Up", style=shape.triangleup, location=location.abovebar, color=nyColor, size=size.tiny)
plotshape(showBreakoutMarkersInput and nyBreakDown, title="New York Break Down", style=shape.triangledown, location=location.belowbar, color=nyColor, size=size.tiny)

alertcondition(asianBreakUp, title="Asian Range Breakout Up", message="Price closed above the Asian opening-range high")
alertcondition(asianBreakDown, title="Asian Range Breakout Down", message="Price closed below the Asian opening-range low")
alertcondition(londonBreakUp, title="London Range Breakout Up", message="Price closed above the London opening-range high")
alertcondition(londonBreakDown, title="London Range Breakout Down", message="Price closed below the London opening-range low")
alertcondition(nyBreakUp, title="New York Range Breakout Up", message="Price closed above the New York opening-range high")
alertcondition(nyBreakDown, title="New York Range Breakout Down", message="Price closed below the New York opening-range low")

// ---------------------------------------------------------------------------
// EMA
// ---------------------------------------------------------------------------

emaValue = ta.ema(emaSource, emaLength)
plot(emaEnabled ? emaValue : na, title="EMA", color=emaColor, linewidth=emaWidth, display=display.pane + display.status_line)

// ---------------------------------------------------------------------------
// TDI reading (Price Line value only - no chart plot, this is a number in the table)
// ---------------------------------------------------------------------------

tdiValue = ta.sma(ta.rsi(close, tdiRsiLength), tdiPriceLineLength)

// ---------------------------------------------------------------------------
// ADX reading (trend strength, no chart plot, this is a number in the table)
// ---------------------------------------------------------------------------

[adxDiPlus, adxDiMinus, adxValue] = ta.dmi(adxDiLength, adxSmoothing)

// ---------------------------------------------------------------------------
// Daily tracker: red/green day history, day-of-week and ADR (average daily range)
// ---------------------------------------------------------------------------

var float dayOpenPrice = na
var float dayHighPrice = na
var float dayLowPrice = na
var float dayClosePrice = na
var int   dayKeyTracker = na
var int   dowTracker = na
var int   dayStartIdx = na
var array<color> dayColorHist = array.new<color>()
var array<int>   dayNumHist = array.new<int>()
var array<int>   dayDowHist = array.new<int>()
var array<float> dayRangeHist = array.new<float>()

var float pivotPP = na
var float pivotR1 = na
var float pivotR2 = na
var float pivotS1 = na
var float pivotS2 = na
var float pivotM1 = na
var float pivotM2 = na
var float pivotM3 = na
var float pivotM4 = na

curDayKey = year(time, tzInput) * 10000 + month(time, tzInput) * 100 + dayofmonth(time, tzInput)
isNewDay = na(dayKeyTracker) or curDayKey != dayKeyTracker

if isNewDay
    if not na(dayOpenPrice)
        dayColorHist.push(dayClosePrice >= dayOpenPrice ? color.green : color.red)
        dayNumHist.push(dayKeyTracker % 100)
        dayDowHist.push(dowTracker)
        dayRangeHist.push(dayHighPrice - dayLowPrice)

        // Classic floor pivots from the day that just finished, plus Mauro's
        // midpoints between each pair of adjacent major levels.
        pivotPP := (dayHighPrice + dayLowPrice + dayClosePrice) / 3
        pivotR1 := 2 * pivotPP - dayLowPrice
        pivotS1 := 2 * pivotPP - dayHighPrice
        pivotR2 := pivotPP + (dayHighPrice - dayLowPrice)
        pivotS2 := pivotPP - (dayHighPrice - dayLowPrice)
        pivotM4 := (pivotR1 + pivotR2) / 2
        pivotM3 := (pivotPP + pivotR1) / 2
        pivotM2 := (pivotPP + pivotS1) / 2
        pivotM1 := (pivotS1 + pivotS2) / 2

        if dayColorHist.size() > daysToShowInput
            dayColorHist.shift()
            dayNumHist.shift()
            dayDowHist.shift()
        if dayRangeHist.size() > adrLength
            dayRangeHist.shift()
    dayOpenPrice := open
    dayHighPrice := high
    dayLowPrice := low
    dayKeyTracker := curDayKey
    dowTracker := dayofweek(time, tzInput)
    dayStartIdx := bar_index
else
    dayHighPrice := math.max(dayHighPrice, high)
    dayLowPrice := math.min(dayLowPrice, low)

dayClosePrice := close

// Shared "still within today's trading day" flag: true until the configured
// cutoff time, used to freeze all of today's rays at end-of-day rather than
// letting them run into the next session.
minutesOfDayGlobal = hour(time, tzInput) * 60 + minute(time, tzInput)
cutoffMinutesGlobal = cutoffHourInput * 60 + cutoffMinuteInput
withinTradingDayGlobal = minutesOfDayGlobal < cutoffMinutesGlobal

adrPips = dayRangeHist.size() == 0 ? na : array.sum(dayRangeHist) / dayRangeHist.size() / pipSize

// Projected high/low for today: one persistent pair of lines, repositioned to
// the new day's open and extended forward each bar (no new object per day).
var line adrHighLine = na
var line adrLowLine = na

if adrEnabled and adrShowLines and not na(adrPips)
    adrHalfPrice = (adrPips / 2) * pipSize
    projHigh = dayOpenPrice + adrHalfPrice
    projLow = dayOpenPrice - adrHalfPrice
    if na(adrHighLine)
        adrHighLine := line.new(x1=dayStartIdx, y1=projHigh, x2=dayStartIdx, y2=projHigh, color=adrLineColor, style=line.style_dashed, width=1)
        adrLowLine := line.new(x1=dayStartIdx, y1=projLow, x2=dayStartIdx, y2=projLow, color=adrLineColor, style=line.style_dashed, width=1)
    line.set_xy1(adrHighLine, dayStartIdx, projHigh)
    line.set_xy2(adrHighLine, bar_index, projHigh)
    line.set_xy1(adrLowLine, dayStartIdx, projLow)
    line.set_xy2(adrLowLine, bar_index, projLow)

// Today's open as a ray: one persistent line, repositioned to the new day's
// open, extended forward each bar only up to the trading-day cutoff (same
// end-of-day rule as the session rays), then frozen for the rest of the day.
var line openLine = na

if openLineEnabled
    if na(openLine)
        openLine := line.new(x1=dayStartIdx, y1=dayOpenPrice, x2=dayStartIdx, y2=dayOpenPrice, color=openLineColor, style=line.style_solid, width=openLineWidth)
    if withinTradingDayGlobal
        line.set_xy1(openLine, dayStartIdx, dayOpenPrice)
        line.set_xy2(openLine, bar_index, dayOpenPrice)

// Mauro pivot grid: floor pivots (PP/R1/R2/S1/S2) plus the four midpoints,
// recalculated once per day from the previous day's H/L/C (see above), drawn
// as rays for today and frozen at the same trading-day cutoff as everything
// else.
var line ppLine = na
var line r1Line = na
var line r2Line = na
var line s1Line = na
var line s2Line = na
var line m1Line = na
var line m2Line = na
var line m3Line = na
var line m4Line = na
var label ppLabel = na
var label r1Label = na
var label r2Label = na
var label s1Label = na
var label s2Label = na
var label m1Label = na
var label m2Label = na
var label m3Label = na
var label m4Label = na

if pivotsEnabled
    [newPPLine, newPPLabel] = pivotLevel(ppLine, ppLabel, pivotPP, "PP", ppColor, pivotLineWidth, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, false)
    ppLine := newPPLine
    ppLabel := newPPLabel
    [newR1Line, newR1Label] = pivotLevel(r1Line, r1Label, pivotR1, "R1", resistanceColor, pivotLineWidth, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, false)
    r1Line := newR1Line
    r1Label := newR1Label
    [newR2Line, newR2Label] = pivotLevel(r2Line, r2Label, pivotR2, "R2", resistanceColor, pivotLineWidth, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, false)
    r2Line := newR2Line
    r2Label := newR2Label
    [newS1Line, newS1Label] = pivotLevel(s1Line, s1Label, pivotS1, "S1", supportColor, pivotLineWidth, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, false)
    s1Line := newS1Line
    s1Label := newS1Label
    [newS2Line, newS2Label] = pivotLevel(s2Line, s2Label, pivotS2, "S2", supportColor, pivotLineWidth, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, false)
    s2Line := newS2Line
    s2Label := newS2Label
    if pivotShowMidpoints
        [newM1Line, newM1Label] = pivotLevel(m1Line, m1Label, pivotM1, "M1", midColor, 1, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, true)
        m1Line := newM1Line
        m1Label := newM1Label
        [newM2Line, newM2Label] = pivotLevel(m2Line, m2Label, pivotM2, "M2", midColor, 1, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, true)
        m2Line := newM2Line
        m2Label := newM2Label
        [newM3Line, newM3Label] = pivotLevel(m3Line, m3Label, pivotM3, "M3", midColor, 1, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, true)
        m3Line := newM3Line
        m3Label := newM3Label
        [newM4Line, newM4Label] = pivotLevel(m4Line, m4Label, pivotM4, "M4", midColor, 1, dayStartIdx, bar_index, pivotExtendBars, withinTradingDayGlobal, pivotShowLabels, true)
        m4Line := newM4Line
        m4Label := newM4Label

// ---------------------------------------------------------------------------
// Pip range table (top-right of the chart)
// ---------------------------------------------------------------------------

var table rangeTable = table.new(position.top_right, 2, tableTopOffsetInput + 7, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if showTableInput and barstate.islast
    todayKey = year(time, tzInput) * 10000 + month(time, tzInput) * 100 + dayofmonth(time, tzInput)

    // Blank rows so the table's top edge clears TradingView's own top-right
    // chart icons instead of sitting under them.
    if tableTopOffsetInput > 0
        for r = 0 to tableTopOffsetInput - 1
            table.cell(rangeTable, 0, r, " ", bgcolor=color.new(color.black, 100), text_size=size.tiny)
            table.cell(rangeTable, 1, r, " ", bgcolor=color.new(color.black, 100), text_size=size.tiny)

    headerRow = tableTopOffsetInput
    table.cell(rangeTable, 0, headerRow, "Session", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(rangeTable, 1, headerRow, "Range", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

    table.cell(rangeTable, 0, headerRow + 1, "Asia", text_color=asianColor, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(rangeTable, 1, headerRow + 1, sessionStatusText(asianState, asianEnabled, todayKey), text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)

    table.cell(rangeTable, 0, headerRow + 2, "London", text_color=londonColor, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(rangeTable, 1, headerRow + 2, sessionStatusText(londonState, londonEnabled, todayKey), text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)

    table.cell(rangeTable, 0, headerRow + 3, "New York", text_color=nyColor, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(rangeTable, 1, headerRow + 3, sessionStatusText(nyState, nyEnabled, todayKey), text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)

    if adrEnabled
        adrText = na(adrPips) ? "..." : str.tostring(adrPips, "#.#") + " pips"
        table.cell(rangeTable, 0, headerRow + 4, "ADR (" + str.tostring(adrLength) + "d)", text_color=adrLineColor, bgcolor=color.new(color.black, 15), text_size=size.small)
        table.cell(rangeTable, 1, headerRow + 4, adrText, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)

    if tdiEnabled
        tdiColor = tdiValue >= 50 ? color.green : color.red
        table.cell(rangeTable, 0, headerRow + 5, "TDI", text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
        table.cell(rangeTable, 1, headerRow + 5, str.tostring(tdiValue, "#.#"), text_color=tdiColor, bgcolor=color.new(color.black, 15), text_size=size.small)

    if adxEnabled
        adxColor = adxValue >= 25 ? color.green : color.gray
        table.cell(rangeTable, 0, headerRow + 6, "ADX", text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
        table.cell(rangeTable, 1, headerRow + 6, str.tostring(adxValue, "#.#"), text_color=adxColor, bgcolor=color.new(color.black, 15), text_size=size.small)

// ---------------------------------------------------------------------------
// Daily red/green day table: 4 weeks, day-of-week letter, week separators
// ---------------------------------------------------------------------------

tableCols = daysToShowInput * 2
var table daysTable = table.new(position.bottom_right, tableCols, 2, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 50))

if showDaysTableInput and barstate.islast
    pastDaysCount = dayNumHist.size()
    col = 0
    int prevDow = na

    if pastDaysCount > 0
        for i = 0 to pastDaysCount - 1
            dow = dayDowHist.get(i)
            if not na(prevDow) and dow <= prevDow
                table.cell(daysTable, col, 0, "", bgcolor=color.new(color.black, 15))
                table.cell(daysTable, col, 1, "", bgcolor=color.new(color.black, 15))
                col += 1
            table.cell(daysTable, col, 0, dayLetter(dow), text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.tiny)
            table.cell(daysTable, col, 1, str.tostring(dayNumHist.get(i)), text_color=color.white, bgcolor=dayColorHist.get(i), text_size=size.small)
            col += 1
            prevDow := dow

    if not na(prevDow) and dowTracker <= prevDow
        table.cell(daysTable, col, 0, "", bgcolor=color.new(color.black, 15))
        table.cell(daysTable, col, 1, "", bgcolor=color.new(color.black, 15))
        col += 1
    todayColor = dayClosePrice >= dayOpenPrice ? color.green : color.red
    table.cell(daysTable, col, 0, dayLetter(dowTracker), text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.tiny)
    table.cell(daysTable, col, 1, str.tostring(dayKeyTracker % 100), text_color=color.white, bgcolor=todayColor, text_size=size.small)
