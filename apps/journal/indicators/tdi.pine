// Traders Dynamic Index (TDI)
// Classic Dean Malone formula: an RSI with a fast/slow signal-line pair and
// Bollinger Bands wrapped around it. Runs in its own pane since it's an
// oscillator (0-100 scale) and can't share the price chart with an overlay
// script.
//
// Add this alongside "Session Opening Range Breakout + EMA" as a second,
// separate indicator on the chart.

//@version=6
indicator("TDI (Traders Dynamic Index)", shorttitle="TDI", overlay=false)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

rsiSource = input.source(close, title="RSI Source", group="RSI")
rsiLength = input.int(13, title="RSI Period", minval=1, group="RSI")

priceLineLength  = input.int(2, title="Price Line (fast) Length", minval=1, group="Signal Lines")
signalLineLength = input.int(7, title="Trade Signal Line (slow) Length", minval=1, group="Signal Lines")

bandLength = input.int(34, title="Volatility Band Length", minval=1, group="Volatility Band")
bandMult   = input.float(1.6185, title="Volatility Band Deviation", minval=0.1, step=0.0001, group="Volatility Band")

overboughtLevel = input.int(68, title="Overbought Level", minval=51, maxval=99, group="Levels")
oversoldLevel   = input.int(32, title="Oversold Level", minval=1, maxval=49, group="Levels")

priceLineColor  = input.color(color.new(color.green, 0), title="Price Line", group="Colors")
signalLineColor = input.color(color.new(color.red, 0), title="Trade Signal Line", group="Colors")
baseLineColor   = input.color(color.new(color.yellow, 0), title="Market Base Line", group="Colors")
bandColor       = input.color(color.new(color.blue, 60), title="Volatility Bands", group="Colors")

// ---------------------------------------------------------------------------
// Calculation
// ---------------------------------------------------------------------------

rsiValue = ta.rsi(rsiSource, rsiLength)

priceLine  = ta.sma(rsiValue, priceLineLength)
signalLine = ta.sma(rsiValue, signalLineLength)

baseLine  = ta.sma(rsiValue, bandLength)
bandDev   = bandMult * ta.stdev(rsiValue, bandLength)
upperBand = baseLine + bandDev
lowerBand = baseLine - bandDev

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------

hline(50, title="Midline", color=color.new(color.gray, 50), linestyle=hline.style_dotted)
hline(overboughtLevel, title="Overbought", color=color.new(color.gray, 70), linestyle=hline.style_dashed)
hline(oversoldLevel, title="Oversold", color=color.new(color.gray, 70), linestyle=hline.style_dashed)

upperPlot = plot(upperBand, title="Upper Volatility Band", color=bandColor, linewidth=1)
lowerPlot = plot(lowerBand, title="Lower Volatility Band", color=bandColor, linewidth=1)
fill(upperPlot, lowerPlot, color=color.new(bandColor, 90), title="Band Fill")

plot(baseLine, title="Market Base Line", color=baseLineColor, linewidth=1)
plot(signalLine, title="Trade Signal Line", color=signalLineColor, linewidth=2)
plot(priceLine, title="RSI Price Line", color=priceLineColor, linewidth=2)
