# Committed on purpose: these are feature flags, not secrets. The Firebase
# project keys come from GitHub secrets / your own .env.local (see CLAUDE.md).
# Firestore's own IndexedDB cache is Mumu's offline store (no Dexie layer).
VITE_FIRESTORE_PERSISTENT_CACHE=true
# Served from Firebase Hosting, so sign-in can stay on this app's own origin.
VITE_AUTH_DOMAIN_FROM_ORIGIN=true
