# `npm run dev:mumu:emulator` — runs against the local Firebase emulators
# (`npm run emulators`) with a throwaway demo project. No real data involved.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-mumu
VITE_FIREBASE_APP_ID=demo-app
